{
  "name": "blogger-theme",
  "version": "1.0.0",
  "description": "A lightweight TypeScript/ESNext library for generating Blogger theme XML using a clean, declarative component API with TSX support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blogger-theme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.js",
      "types": "./dist/jsx-dev-runtime.d.ts"
    }
  },

  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antinna/blogger-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Antinna/blogger-theme/issues"
  },
  "homepage": "https://github.com/Antinna/blogger-theme#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Manishmg3994"
  },

  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test-watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.1.0-dev.20260726.1",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "blogger",
    "blogspot",
    "theme",
    "template",
    "xml",
    "tsx",
    "jsx",
    "typescript"
  ],
  "author": "Manishmg3994",
  "license": "MIT"
}
