{
  "name": "@antinna/blogger-theme",
  "version": "2.0.0",
  "description": "A lightweight modern React-first library for generating Blogger theme XML from standard React component trees.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blogger-theme": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antinna/blogger-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Antinna/blogger-theme/issues"
  },
  "homepage": "https://github.com/Antinna/blogger-theme#readme",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && cp src/globals.d.ts dist/globals.d.ts && node -e \"const fs = require('fs'); const d = fs.readFileSync('dist/index.d.ts', 'utf8'); fs.writeFileSync('dist/index.d.ts', '/// <reference path=\\\"./globals.d.ts\\\" />\\n' + d);\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@antinna/types-blogger-react": "file:./packages/types-blogger-react",
    "esbuild": "^0.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "blogger",
    "blogspot",
    "theme",
    "template",
    "xml",
    "react",
    "jsx",
    "typescript"
  ],
  "license": "MIT"
}
