{
  "name": "blogger-theme",
  "version": "1.0.0",
  "description": "A lightweight TypeScript/ESNext library for generating Blogger theme XML using a clean, declarative component API with TSX support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blogger-theme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.js",
      "types": "./dist/jsx-dev-runtime.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "blogger",
    "blogspot",
    "theme",
    "template",
    "xml",
    "tsx",
    "jsx",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
