{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleSuffixes": [""],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@antinna/blogger-theme",
   
    "paths": {
      "@antinna/blogger-theme": ["./src/index.ts"],
      "@antinna/blogger-theme/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
